<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="user" class="com.pulkit.learning.User">
        <constructor-arg ref="desktop"></constructor-arg>
    </bean>
    <bean id="computer" class="com.pulkit.learning.Computer" abstract="true"></bean>
    <bean id="laptop" class="com.pulkit.learning.Laptop"></bean>
    <bean id="desktop" class="com.pulkit.learning.Desktop"></bean>
</beans>